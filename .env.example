# ─── DATABASE ─────────────────────────────────────────────────────────────────
# LOCAL (development): SQLite — geen setup nodig
DATABASE_URL=local

# PRODUCTIE (Supabase Postgres — Transaction pooler, poort 6543):
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Alternatief: Neon Postgres
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=vervang-dit-door-een-random-string-van-minimaal-32-tekens

# Resend API-key voor magic-link login
AUTH_RESEND_KEY=

# ─── EMAIL ────────────────────────────────────────────────────────────────────
# Lokaal/test: onboarding@resend.dev (Resend sandbox)
# Productie saf4.nl: noreply@saf4.nl (domein moet geverifieerd zijn bij Resend)
EMAIL_FROM=noreply@saf4.nl

# Resend API-key voor contactformulier-e-mails (mag dezelfde zijn als AUTH_RESEND_KEY)
RESEND_API_KEY=

# ─── APP URL ──────────────────────────────────────────────────────────────────
# Lokaal:
NEXTAUTH_URL=http://localhost:3001

# Vercel preview (deel 1 deploy):
# NEXTAUTH_URL=https://jouw-project.vercel.app
# NEXT_PUBLIC_SITE_URL=https://jouw-project.vercel.app

# Productie saf4.nl (deel 2 deploy):
# NEXTAUTH_URL=https://saf4.nl
# NEXT_PUBLIC_SITE_URL=https://saf4.nl

# Canonical links + sitemap (optioneel lokaal)
# NEXT_PUBLIC_SITE_URL=https://saf4.nl

# ─── MEDIA OPSLAG ─────────────────────────────────────────────────────────────
# LOCAL (standaard als STORAGE_PROVIDER niet gezet):
# Bestanden in public/uploads/ — alleen voor development

# SUPABASE STORAGE (aanbevolen productie — zelfde project als DATABASE_URL):
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
# STORAGE_REGION=eu-central-1
# STORAGE_BUCKET=media
# STORAGE_ACCESS_KEY_ID=          # Supabase → Storage → S3 Access Keys
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://[project-ref].supabase.co/storage/v1/object/public/media

# Alternatief: Cloudflare R2
# STORAGE_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
# STORAGE_REGION=auto

# ─── DEV-ONLY ─────────────────────────────────────────────────────────────────
# ENABLE_DEV_LOGIN=true
