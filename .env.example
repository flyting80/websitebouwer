# ─── DATABASE ─────────────────────────────────────────────────────────────────
# LOCAL (development): SQLite — geen setup nodig
DATABASE_URL=local

# PRODUCTIE (Supabase Postgres — Transaction pooler, poort 6543):
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=vervang-dit-door-een-random-string-van-minimaal-32-tekens

# Enige admin-account (e-mail + wachtwoord)
ADMIN_EMAIL=admin@voorbeeld.nl
ADMIN_PASSWORD=vervang-dit-door-een-sterk-wachtwoord

# ─── APP URL ──────────────────────────────────────────────────────────────────
# Lokaal:
NEXTAUTH_URL=http://localhost:3001

# Vercel preview (deel 1 deploy):
# NEXTAUTH_URL=https://jouw-project.vercel.app
# NEXT_PUBLIC_SITE_URL=https://jouw-project.vercel.app

# Productie (deel 2 deploy):
# NEXTAUTH_URL=https://jouwdomein.nl
# NEXT_PUBLIC_SITE_URL=https://jouwdomein.nl

# ─── MEDIA OPSLAG ─────────────────────────────────────────────────────────────
# LOCAL (standaard zonder cloud-credentials):
# Bestanden in public/uploads/ — alleen voor development

# SUPABASE STORAGE (aanbevolen op Vercel — REST, geen S3-keys):
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=          # Supabase → Project Settings → API → service_role
# STORAGE_BUCKET=media                # optioneel (default: media)
# Maak bucket "media" public in Supabase Storage

# Alternatief: S3-protocol (AWS / R2 / Supabase S3 Access Keys):
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
# STORAGE_REGION=eu-central-1
# STORAGE_BUCKET=media
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://[project-ref].supabase.co/storage/v1/object/public/media

# ─── DEV-ONLY ─────────────────────────────────────────────────────────────────
# ENABLE_DEV_LOGIN=true
